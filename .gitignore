# ─────────────────────────────────────────────
#  VolantiniPro — .gitignore
#  Stack: Next.js / React / Vite · Supabase · Node.js · GIS/PostGIS
# ─────────────────────────────────────────────

# ── Environment ──────────────────────────────
.env
.env.*
!.env.example

# ── Node ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# ── Build output ─────────────────────────────
dist/
build/
.next/
out/
coverage/

# ── Vite ─────────────────────────────────────
.vite/

# ── Logs ─────────────────────────────────────
*.log
logs/

# ── OS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Supabase local dev ────────────────────────
.supabase/

# ── Temporary GIS / exports ──────────────────
*.geojson.tmp
*.sqlite
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.mbtiles
*.shp
*.dbf
*.shx
*.prj

# ── Cache ────────────────────────────────────
.cache/
.tmp/
*.cache

# ── Local exports / backups ──────────────────
backups/
exports/
tmp/

# ── Python ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# ── Large datasets — local only ──────────────
data/raw/
data/cache/
data/istat/raw/
data/istat/download/

# ─────────────────────────────────────────────
#  DO NOT IGNORE (kept in repo):
#    supabase/migrations/
#    supabase/functions/
#    src/
#    scripts/
#    data/migrations/
#    data/istat/processed/
#    *.geojson  (final production GeoJSON)
# ─────────────────────────────────────────────

# TERRITORIAL DATA
data/dbgt/downloads/
data/gtfs/
data/osm/
data/**/*.zip
data/**/*.7z
data/**/*.rar
data/**/*.gpkg
data/**/*.shp
data/**/*.dbf
data/**/*.sqlite

