{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "volantinipro.it"
        }
      ],
      "destination": "https://www.volantinipro.it/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app-driver",
      "destination": "/app-driver/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
