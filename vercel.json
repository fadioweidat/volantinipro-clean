{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "volantinipro.it"
        }
      ],
      "destination": "https://www.volantinipro.it/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app-driver",
      "destination": "/app-driver/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/servizi/door-to-door",
      "destination": "/servizi/door-to-door/index.html"
    },
    {
      "source": "/servizi/hand-to-hand",
      "destination": "/servizi/hand-to-hand/index.html"
    },
    {
      "source": "/servizi/business",
      "destination": "/servizi/business/index.html"
    },
    {
      "source": "/distribuzione-volantini-milano",
      "destination": "/distribuzione-volantini-milano/index.html"
    },
    {
      "source": "/preventivo",
      "destination": "/preventivo/index.html"
    },
    {
      "source": "/preventivo-rapido",
      "destination": "/preventivo-rapido/index.html"
    },
    {
      "source": "/consulente",
      "destination": "/consulente/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/termini",
      "destination": "/termini/index.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy/index.html"
    },
    {
      "source": "/prezzi-distribuzione-volantini",
      "destination": "/prezzi-distribuzione-volantini/index.html"
    },
    {
      "source": "/distribuzione-volantini-monza",
      "destination": "/distribuzione-volantini-monza/index.html"
    },
    {
      "source": "/distribuzione-volantini-bergamo",
      "destination": "/distribuzione-volantini-bergamo/index.html"
    },
    {
      "source": "/distribuzione-volantini-brescia",
      "destination": "/distribuzione-volantini-brescia/index.html"
    },
    {
      "source": "/distribuzione-volantini-como",
      "destination": "/distribuzione-volantini-como/index.html"
    },
    {
      "source": "/distribuzione-volantini-varese",
      "destination": "/distribuzione-volantini-varese/index.html"
    },
    {
      "source": "/distribuzione-volantini-sesto-san-giovanni",
      "destination": "/distribuzione-volantini-sesto-san-giovanni/index.html"
    },
    {
      "source": "/distribuzione-volantini-cinisello-balsamo",
      "destination": "/distribuzione-volantini-cinisello-balsamo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
