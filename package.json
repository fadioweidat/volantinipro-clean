{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "test:phase7": "node --import tsx --test tests/final_distribution_report.test.mjs",
    "test:ai-admin": "node --import tsx --test tests/ai_core_admin_dashboard.test.mjs tests/ai_core_dispatcher.test.mjs",
    "test:ai-territorial-report": "node --import tsx --test tests/ai_core_territorial_report.test.mjs tests/ai_core_dispatcher.test.mjs",
    "test:quote-assistant": "node --import tsx --test tests/quote_contextual_assistant.test.mjs tests/ai_core_dispatcher.test.mjs tests/ai_territorial_step2_integration.test.mjs tests/customer_contact_options.test.mjs",
    "test:control-center": "node --import tsx --test tests/platform_status_center.test.mjs tests/platform_monitoring_persistence.test.mjs tests/gps_zombie_prevention.test.mjs",
    "test:admin-home": "node --import tsx --test tests/admin_operational_home.test.mjs tests/admin_commercial_home.test.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "snapshot:hero": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-hero.mjs",
    "snapshot:milano": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-milano.mjs",
    "test:driver-diagnostics": "node --import tsx --test tests/driver_diagnostics.test.mjs tests/driver_diagnostics_off_behavior.test.mjs tests/driver_diagnostics_hook_off_behavior.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "import:istat": "node data/istat/import_data.mjs --scope=lombardia",
    "import:istat:italy": "node data/istat/import_data.mjs --scope=italy",
    "import:istat:dry-run": "node data/istat/import_data.mjs --scope=lombardia --dry-run=true",
    "import:economic": "node data/istat/import_economic_indicators.mjs --scope=lombardia",
    "import:economic:dry-run": "node data/istat/import_economic_indicators.mjs --scope=lombardia --dry-run=true",
    "import:omi": "node data/omi/import_omi_zones.mjs",
    "import:omi:dry-run": "node data/omi/import_omi_zones.mjs --dry-run=true",
    "import:gtfs": "node scripts/import_gtfs.mjs",
    "import:gtfs:dry-run": "node scripts/import_gtfs.mjs --dry-run=true",
    "import:addresses": "node scripts/import_osm_addresses.mjs",
    "import:addresses:dry-run": "node scripts/import_osm_addresses.mjs --dry-run=true",
    "download:dbgt": "node data/dbgt/download_dbgt_lombardia.mjs",
    "import:dbgt": "node data/dbgt/import_dbgt_address_points.mjs",
    "import:dbgt:dry-run": "node data/dbgt/import_dbgt_address_points.mjs --dry-run=true",
    "test": "node scripts/run-test-suite.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "node scripts/configure-capacitor-android.mjs && npx cap sync android && npx cap open android",
    "cap:ios:init": "npm run build && npx cap add ios && node scripts/configure-capacitor-ios.mjs && npx cap sync ios",
    "cap:ios": "node scripts/configure-capacitor-ios.mjs && npx cap sync ios && npx cap open ios",
    "cap:android:init": "npm run build && npx cap add android && node scripts/configure-capacitor-android.mjs && npx cap sync android",
    "test:seo-html": "node --test tests/seo_initial_html.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.5.17",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.20.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "shapefile": "^0.6.6",
    "vite": "^7.0.0",
    "xlsx": "^0.18.5",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "puppeteer-core": "^25.10.0",
    "react-test-renderer": "^19.2.6",
    "tsx": "^4.23.1",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.9.2"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
