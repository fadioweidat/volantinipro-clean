# =============================================================================
# VolantiniPro - Environment variables
# =============================================================================
# Placeholder file. NEVER put real keys/secrets here.
#
# Classes:
#   [A] Frontend (Vite / Vercel)  - prefix VITE_, bundled into the client, PUBLIC by design
#   [B] Server (Supabase Edge Functions) - set as Supabase Secrets, server-only
#   [C] Dev / test only           - never set in Production
#   [D] Optional                  - has a safe fallback / feature is off by default
#
# Rule: service_role and any secret MUST NOT use the VITE_ prefix (Vite would
# ship it to the browser). See vite.config.js (loadEnv('', ...) keeps
# non-VITE_ vars in the Node build process only).
# =============================================================================


# -- [A] SUPABASE (frontend) --------------------------------------------------
# REQUIRED in Production. Public values (anon/publishable key is safe client-side;
# RLS is the security boundary). Current key format: sb_publishable_xxx.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# [D] OPTIONAL - base URL for Edge Function calls. Falls back to VITE_SUPABASE_URL
# inside the code when unset. Set only if functions live on a different host.
VITE_API_BASE_URL=https://your-project.supabase.co
# [D] OPTIONAL - explicit function URLs. Derived from VITE_API_BASE_URL /
# VITE_SUPABASE_URL when unset.
VITE_ANALYSIS_ISTAT_URL=https://your-project.supabase.co/functions/v1/analysis-istat
VITE_ANALYSIS_POI_URL=https://your-project.supabase.co/functions/v1/analysis-poi-search


# -- [A] PUBLIC APP URL ------------------------------------------------------
# REQUIRED in Production. Absolute base for links opened on ANOTHER device
# (driver WhatsApp assignment/tracking links). Code prefers this; otherwise
# falls back to window.location.origin (src/lib/publicAppUrl.js).
# Production: the canonical domain. Dev: the LAN IP of the dev server.
VITE_PUBLIC_APP_URL=https://www.volantinipro.it


# -- [A/D] CUSTOMER SUPPORT CONTACTS (frontend) ---------------------------
# Used by the configurator CTAs for the graphic service / print-file sending.
# [D] OPTIONAL - support email. Falls back to info@volantinipro.it (the value
# already used in the quote PDF footer).
VITE_SUPPORT_EMAIL=info@volantinipro.it
# [D] OPTIONAL - WhatsApp number, digits only incl. country code (e.g. 393331234567).
# The "Contatta su WhatsApp" button is HIDDEN when this is unset - no
# placeholder / invented number is ever shown.
VITE_SUPPORT_WHATSAPP=
# [D] OPTIONAL - feature flag (NOT a secret) for the "Invia richiesta" button in
# the graphic-service card. When "true" AND VITE_SUPABASE_URL is set, the card
# offers backend send (Edge Function send-graphic-request + Resend) with mailto
# as the secondary CTA; otherwise only the mailto fallback is shown.
# This is a boolean flag only - the RESEND_API_KEY is NEVER in the frontend.
VITE_GRAPHIC_REQUEST_ENABLED=false


# -- [A] MAPS (frontend) ----------------------------------------------------
# REQUIRED in Production for the Step2 map. Mapbox public token (pk.*).
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# NOTE: VITE_OVERPASS_ENDPOINT (client-side Overpass override) e' stato
# rimosso: la ricerca POI del configuratore passa ora dal proxy server-side
# /functions/v1/poi-search (vedi OVERPASS_ENDPOINT + POI_SEARCH_* sotto).


# -- [A] PAYMENT MODE (frontend, post-confirmation page) ------------------
# OPTIONAL. "manual_contact" (default when unset): no online payment, no bank
# coordinates shown; after confirming a campaign the customer sees the receipt
# message + contact CTAs (WhatsApp primary, Email, Dashboard) and VolantiniPro
# follows up with payment instructions. Any other value (e.g. "bank_transfer")
# re-enables the legacy bonifico block below. Real payment state is untouched.
VITE_PAYMENT_MODE=manual_contact

# -- [A] BANK TRANSFER (frontend, legacy bonifico block) ------------------
# Only used when VITE_PAYMENT_MODE is NOT "manual_contact".
# When active in Production these are displayed to customers, not secret.
VITE_IBAN=IT00X0000000000000000000000000
VITE_INTESTATARIO=VolantiniPro Srl
VITE_BANCA=Your Bank


# -- [A/D] FEATURE FLAGS (frontend) ---------------------------------------
# OPTIONAL. Any value other than the exact string "true" leaves the feature OFF.
VITE_FEATURE_AI_CUSTOMER_DASHBOARD=false
VITE_FEATURE_AI_ADMIN_DASHBOARD=false
VITE_AI_TERRITORIAL_STEP2_ENABLED=false
VITE_ENABLE_ADDRESS_POINTS=false


# -- [C] DEV / TEST ONLY (frontend) -------------------------------------
# Do NOT set any of these in Production.
# VITE_ALLOW_MOCK_DATA  - only honoured when import.meta.env.DEV is true.
VITE_ALLOW_MOCK_DATA=false
# VITE_DEBUG_STEP2      - verbose Step2 logging.
VITE_DEBUG_STEP2=false
# VITE_ENABLE_DRIVER_DEV_BYPASS - enables the local dev-server-only endpoint
# that mints a real test session (dev/driverTestSessionPlugin.js, never in
# `vite build`). MUST stay unset/false in Production.
VITE_ENABLE_DRIVER_DEV_BYPASS=false


# -- [B] SUPABASE (Edge Functions, server-only) --------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by Supabase into deployed functions - listed here for local `supabase serve`.
# SERVICE_ROLE is a full-access secret: server-only, never VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# REQUIRED in Production (server). Absolute site URL used by admin-grant-access
# to build the magic-link emailRedirectTo (`${SITE_URL}/dashboard`).
# Code fallback is "https://app.volantinipro.it" - set this explicitly so the
# magic link matches the real domain.
SITE_URL=https://www.volantinipro.it

# REQUIRED for the fadi-gateway Edge Function (server). NOT a secret - it is
# server-side configuration. Comma-separated exact origins allowed to call the
# gateway from a browser. Production must include the canonical origin (add the
# apex too only if it is served directly rather than 301-redirected to www).
FADI_ALLOWED_ORIGINS=https://www.volantinipro.it
# REQUIRED for fadi-gateway (server SECRET). Shared secret for the gateway.
FADI_ONE_SECRET=your-fadi-gateway-secret
# [D] OPTIONAL - fadi-gateway rate limiting (defaults: 120 / 60000ms).
FADI_RATE_LIMIT_MAX=120
FADI_RATE_LIMIT_WINDOW_MS=60000

# REQUIRED for the platform-health-collector Edge Function (server SECRET).
# Authorises the scheduled collector; keep in Supabase Secrets / Vault only.
PLATFORM_HEALTH_COLLECTOR_SECRET=your-collector-secret


# -- [B] MAPS / POI (Edge Functions, server-only) ----------------------
# analysis-istat reads MAPBOX_TOKEN (falls back to VITE_MAPBOX_TOKEN).
MAPBOX_TOKEN=pk.your_mapbox_token
# analysis-poi-search: at least one POI provider key is needed for that feature.
GOOGLE_PLACES_API_KEY=AIza_your_key
GOOGLE_API_KEY=AIza_your_key
FOURSQUARE_API_KEY=fsq3_your_key
# [D] OPTIONAL - server Overpass endpoint, primo provider provato dalle Edge
# Functions analysis-poi-search, road-network e poi-search. Se assente, i
# default hardcoded (kumi.systems, overpass-api.de, overpass.private.coffee)
# restano comunque come fallback.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# [D] OPTIONAL - proxy road-network (Admin copertura automatica). Il browser
# chiama SOLO /functions/v1/road-network, mai Overpass diretto (CORS/504).
ROAD_NETWORK_RATE_MAX=30
ROAD_NETWORK_RATE_WINDOW_MS=60000
ROAD_NETWORK_CACHE_TTL_MS=3600000
ROAD_NETWORK_TIMEOUT_MS=25000
# [D] OPTIONAL - proxy poi-search (configuratore Step2, attivita'/POI). Il
# browser chiama SOLO /functions/v1/poi-search, mai Overpass diretto (CORS/504).
POI_SEARCH_RATE_MAX=40
POI_SEARCH_RATE_WINDOW_MS=60000
POI_SEARCH_CACHE_TTL_MS=3600000
POI_SEARCH_TIMEOUT_MS=25000


# -- [B] AI (Edge Functions, server-only) ------------------------------
# REQUIRED only if the AI dashboards/assistants are enabled. server SECRET.
OPENAI_API_KEY=sk-your-openai-key


# -- [B/D] EMAIL / RESEND (Edge Functions, server-only) ---------------
# TRANSACTIONAL EMAIL via Resend. RESEND_API_KEY MUST stay server-side only:
# never prefixed VITE_, never in the client bundle, never logged, never in git.
# Used by: send-email-conferma, send-graphic-request (via _shared/sendTransactionalEmail).
#
# RESEND_API_KEY   - the Resend API key (re_...). Server env only. Fail-closed:
#                    if unset, no email is attempted (endpoints return a
#                    controlled "EMAIL_NOT_CONFIGURED" and the UI keeps mailto).
# RESEND_FROM_EMAIL      - verified sender. STRUCTURE example (do NOT assume the
#                          domain is verified on Resend until it actually is):
#                            RESEND_FROM_EMAIL=VolantiniPro <noreply@volantinipro.it>
# RESEND_REPLY_TO_EMAIL   - optional default Reply-To, e.g. info@volantinipro.it
# GRAPHIC_REQUEST_TO      - optional. Fixed INTERNAL recipient for the graphic
#                           service request. Defaults to RESEND_REPLY_TO_EMAIL /
#                           VITE_SUPPORT_EMAIL / info@volantinipro.it. The browser
#                           can NEVER choose the recipient.
# GRAPHIC_REQUEST_RATE_MAX / GRAPHIC_REQUEST_RATE_WINDOW_MS - optional rate limit
#                           for the public endpoint (defaults: 5 / 60000ms).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
GRAPHIC_REQUEST_TO=


# -- [C] DATA IMPORT SCRIPTS ONLY (local Node, never runtime) ----------
GTFS_SOURCE_URL=https://example.com/gtfs/stops.txt
GTFS_STOPS_URL=https://example.com/gtfs/stops.txt
OMI_DATASET_PATH=
OMI_TABLE_NAME=


# -- BUILD-TIME (injected automatically) ------------------------------
# VERCEL_GIT_COMMIT_SHA is set by Vercel during `vite build` (read in
# vite.config.js -> __COMMIT_SHA__). No action needed; empty in local builds.
